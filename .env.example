# Django backend — generate a unique secret; never commit real values.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Keep blank for local SQLite, or use the connection string from Supabase.
# For production, DATABASE_URL is required. Use the appropriate Supabase PostgreSQL URL/pooler.
DATABASE_URL=

# Allowed origins are exact scheme + host values, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CROSS_SITE_COOKIES=false
SECURE_SSL_REDIRECT=false
TIME_ZONE=Africa/Kigali

# Optional Supabase Storage — only the Django server may read the service-role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key
SUPABASE_STORAGE_BUCKET=alib-media
MAX_UPLOAD_BYTES=20971520

# Frontend (put in frontend/.env.local). Usually set to the API's origin without /api/v1.
VITE_API_URL=http://127.0.0.1:8000
